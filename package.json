{
  "name": "laboratorios-dentales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.mjs && prisma db push",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/ensure-env.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/ensure-env.mjs && prisma db push && tsx prisma/seed.ts && tsx scripts/backfill-line-items.ts",
    "db:backfill": "tsx scripts/backfill-line-items.ts",
    "postinstall": "node scripts/ensure-env.mjs && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.2",
    "date-fns": "4.1.0",
    "next": "15.5.22",
    "next-auth": "4.24.15",
    "nodemailer": "9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.10.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.8",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.57",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "dotenv": "16.5.0",
    "eslint": "9.28.0",
    "eslint-config-next": "15.5.22",
    "prisma": "5.22.0",
    "tailwindcss": "4.1.8",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "nodemailer": "9.0.3",
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "minimatch": {
      "brace-expansion": "5.0.8"
    }
  }
}
